{
  "theme": {
    "color" : "#253848",
    "css":"greenseas.css"
  },
  "tooltip": {
    "fields": [
      "nom","date_creation"
    ],
    "template":"{{name}}"
  },
  "map": {
		"center": [-227028,6182514],
		"zoom": 15,
    "width": "100%",
    "overview": false,
    "url": "http://{a-c}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png",
    "animation": true
  },
  "data": {
    "template": {
      "name": "carousel",
      "size": "50%"
    },
    "url": "stories/greenseas/greenseas.geojson",
    "orderby": "id",
    "fields": [
      {
        "name": "id"
      }
    ],
    "id": "id",
    "tpl": "stories/greenseas/greenseas.mst",
    "analyse": {
      "type": "categories",
      "field": "corpus_map",
      "values": ["c_01","c_02","c_03","c_04","c_05","c_06","c_07","none"],
      "styles": [
        {
          "fill": {
            "color": "rgba(46,84,101,0.6)"
          },
          "stroke": {
            "color": "rgba(46,84,101,0.8)",
            "width": 1
          }
        },
        {
          "fill": {
            "color": "rgba(61,115,118,0.6)"
          },
          "stroke": {
            "color": "rgba(61,115,118,0.8)",
            "width": 1
          }
        },
        {
          "fill": {
            "color": "rgba(127,179,179,0.6)"
          },
          "stroke": {
            "color": "rgba(127,179,179,0.8)",
            "width": 1
          }
        },
        {
          "fill": {
            "color": "rgba(105,149,116,0.6)"
          },
          "stroke": {
            "color": "rgba(105,149,116,0.8)",
            "width": 1
          }
        },
        {
          "fill": {
            "color": "rgba(146,180,155,0.6)"
          },
          "stroke": {
            "color": "rgba(146,180,155,0.8)",
            "width": 1
          }
        },
        {
          "fill": {
            "color": "rgba(182,210,197,0.6)"
          },
          "stroke": {
            "color": "rgba(182,210,197,0.8)",
            "width": 1
          }
        },
        {
          "fill": {
            "color": "rgba(58,143,152,0.6)"
          },
          "stroke": {
            "color": "rgba(58,143,152,0.8)",
            "width": 1
          }
        },
        {
          "fill": {
            "color": "rgba(37,56,72,0)"
          },
          "stroke": {
            "color": "rgba(37,56,72,0)",
            "width": 1
          }
        }
      ]
    },
    "hightlightstyle": {
      "fill": {
        "color": "rgba(37,56,72,0.8)"
      },
      "icon": {
        "src" : "stories/greenseas/img/icon_mapSelect.svg",
        "scale" : 0.35
      },
      "stroke": {
        "color": "rgba(37,56,72,0)",
        "width": 2
      }
    }
  },
  "extradata": {
    "url": "greenseas_info.csv",
    "linkfield": "id_story"
  }
}