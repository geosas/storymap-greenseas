{
  "theme": {
    "color" : "#002f43",
    "css":"greenseas.css"
  },
  "tooltip": {
    "fields": [
      "nom","date_creation"
    ],
    "template":"{{name}}"
  },
  "map": {
		"center": [-227028,6182514],
		"zoom": 15,
    "width": "100%",
    "overview": false,
    "url": "http://{a-c}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png",
    "animation": true
  },
  "data": {
    "template": {
      "name": "carousel",
      "size": "50%"
    },
    "url": "stories/greenseas/greenseas.geojson",
    "orderby": "id",
    "fields": [
      {
        "name": "id"
      }
    ],
    "id": "id",
    "tpl": "stories/greenseas/greenseas.mst",
    "analyse": {
      "type": "categories",
      "field": "corpus_map",
      "values": ["c_01","c_02","c_03","c_04","c_05","c_06","c_07","none"],
      "styles": [
