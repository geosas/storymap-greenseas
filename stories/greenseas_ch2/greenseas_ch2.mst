{{#id}}
<div class="container-fluid slideItem_{{type}} slide__item mt-4" id="slide_{{id}}" item-type="{{type}}" item-corpus="{{zoom_code}}" item-insee="{{code_insee}}">   
    <div id="customControlStory">
      <button class="btn__controlStory" id="btn__homeStory" onclick="goToSlide(1);" title="Revenir à l'accueil du chapitre">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M13 19H19V9.97815L12 4.53371L5 9.97815V19H11V13H13V19ZM21 20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V9.48907C3 9.18048 3.14247 8.88917 3.38606 8.69972L11.3861 2.47749C11.7472 2.19663 12.2528 2.19663 12.6139 2.47749L20.6139 8.69972C20.8575 8.88917 21 9.18048 21 9.48907V20Z"></path></svg>
      </button>
      <div class="legend__container">
        <button class="btn__controlStory btn__controlLegend" onclick="toggleLegend(this);" title="Afficher la légende">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20.0833 15.1999L21.2854 15.9212C21.5221 16.0633 21.5989 16.3704 21.4569 16.6072C21.4146 16.6776 21.3557 16.7365 21.2854 16.7787L12.5144 22.0412C12.1977 22.2313 11.8021 22.2313 11.4854 22.0412L2.71451 16.7787C2.47772 16.6366 2.40093 16.3295 2.54301 16.0927C2.58523 16.0223 2.64413 15.9634 2.71451 15.9212L3.9166 15.1999L11.9999 20.0499L20.0833 15.1999ZM20.0833 10.4999L21.2854 11.2212C21.5221 11.3633 21.5989 11.6704 21.4569 11.9072C21.4146 11.9776 21.3557 12.0365 21.2854 12.0787L11.9999 17.6499L2.71451 12.0787C2.47772 11.9366 2.40093 11.6295 2.54301 11.3927C2.58523 11.3223 2.64413 11.2634 2.71451 11.2212L3.9166 10.4999L11.9999 15.3499L20.0833 10.4999ZM12.5144 1.30864L21.2854 6.5712C21.5221 6.71327 21.5989 7.0204 21.4569 7.25719C21.4146 7.32757 21.3557 7.38647 21.2854 7.42869L11.9999 12.9999L2.71451 7.42869C2.47772 7.28662 2.40093 6.97949 2.54301 6.7427C2.58523 6.67232 2.64413 6.61343 2.71451 6.5712L11.4854 1.30864C11.8021 1.11864 12.1977 1.11864 12.5144 1.30864ZM11.9999 3.33233L5.88723 6.99995L11.9999 10.6676L18.1126 6.99995L11.9999 3.33233Z"></path></svg>
        </button>
        <div class="legend__block">
            <div>Premier signalement d'algues vertes issu des enquêtes communales CEVA sur le ramassage</div>
            <div class="legend__itemGrid my-2">
              <div class="legend__item"><span style="color:#244b5a">⬤</span> 1982 - 1983</div>
              <div class="legend__item"><span style="color:#2f6f84">⬤</span> 1983 - 1986</div>
              <div class="legend__item"><span style="color:#3f9097">⬤</span> 1987 - 1991</div>
              <div class="legend__item"><span style="color:#63b2af">⬤</span> 1992 - 1996</div>
              <div class="legend__item"><span style="color:#b9e6dd">⬤</span> 1997 - 2003</div>
            </div>
            <a href="https://geosas.fr/geonetwork/srv/fre/catalog.search#/metadata/1a9aded5-685e-4196-a255-6a5a18c9271f" target="_blank" rel="noopener noreferrer">En savoir plus</a>
        </div>
      </div>
    </div>
    <!-- NIV 3 - DATA -->
    <div class="template__data corpus_{{zoom_code}}">
        <span class="item__badge">{{zoom}}</span>
        <h2 class="my-3">{{name}}</h2> 
        <div class="tplData_metadata">
          {{#date_production}}
          <div class="data_metada">
            <div class="metadata_title">Date de production ou de collecte</div>
            <p>{{date_production}}</p>
          </div>
          {{/date_production}}
          {{#date_info}}
          <div class="data_metada">
            <div class="metadata_title">Date de l'information collectée</div>
            <p>{{date_info}}</p>
          </div>
          {{/date_info}}
          {{#source_auteur}}
          <div class="data_metada">
            <div class="metadata_title">Source(s) / Auteur(s)</div>
            {{#url_source}}
              <p><a target="_blank" href="{{url_source}}">{{source_auteur}}</a></p>
            {{/url_source}}
            {{^url_source}}
              <p>{{source_auteur}}</p>
            {{/url_source}}
          </div>
          {{/source_auteur}}
          {{#lieu}}
          <div class="data_metada">
            <div class="metadata_title">Lieu</div>
            <p>{{lieu}}</p>
          </div>
          {{/lieu}}
        </div>  
        {{#id_img}}
        <div class="tplData_img">
            <img src="stories/greenseas_ch2/corpus_doc/{{id_img}}" class="img-fluid" alt="{{name}}" id="image_{{id}}">
            <a class="img__btnOpen" target="_blank" href="stories/greenseas_ch2/corpus_doc/{{id_img}}" title="Ouvrir en plein écran">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M7 8.41421V12L5 12L5 5L12 5V7L8.41421 7L17 15.5858V12L19 12L19 19H12V17H15.5858L7 8.41421Z"></path></svg>
            </a>
        </div>
        {{/id_img}} 
        {{#id_son}}
        <div class="tplData_sound">
          <audio controls src="stories/greenseas_ch2/corpus_doc/{{id_son}}" controls autoplay muted></audio>
        </div>
        {{/id_son}}  
        {{#id_doc}}
        <div class="tplData_doc my-3">
            <a target="_blank" href="stories/greenseas_ch2/corpus_doc/{{id_doc}}" class="btn btn__doc">
              <span>Consulter le document</span> 
            </a>
        </div>
        {{/id_doc}}   
        <p>{{{texte}}}</p> 
    </div> 
    <!-- NIV 2 - ZOOM -->
    <div class="template__zoom" style="background-color:var(--color-n2)">
        <div class="templateZoom__header" >
          <div><img src="stories/greenseas_ch2/img/icon_zoom_{{zoom_code}}.svg"/></div>
          <h2>{{name}}</h2> 
        </div>  
        <div class="templateZoom__body">  
          <div>
            {{{texte}}}
          </div>  
          <h4>Documents associés</h4>
          <div class="corpus_dataList {{zoom_code}} mt-3" id="corpusDataList_{{zoom_code}}"></div>
        </div>
    </div> 
    <!-- NIV 1 - INTRO -->
    <div class="template__intro">      
        <h1>Quand et où les « marées vertes » sont-elles apparues ?</h1>
        {{{texte}}}
        <div id="corpusCardsList" class="my-4">            
            <a type="button" onclick="goToSlide(10);" class="corpus__card" style="background-color:var(--color-n2)">
                <div><img src="stories/greenseas_ch2/img/icon_zoom_n_01.svg"/></div>
                <div class="corpus__cardTitle">Résultats de l’analyse des enquêtes communales</div>
            </a>
            <a type="button" onclick="goToSlide(20);" class="corpus__card" style="background-color:var(--color-n2)">
                <div><img src="stories/greenseas_ch2/img/icon_zoom_n_02.svg"/></div>
                <div class="corpus__cardTitle">Zoom sur Hillion</div>
            </a>
            <a type="button" onclick="goToSlide(30);" class="corpus__card" style="background-color:var(--color-n2)">
                <div><img src="stories/greenseas_ch2/img/icon_zoom_n_02.svg"/></div>
                <div class="corpus__cardTitle">Zoom sur Baie de Douarnenez</div>
            </a>
            <a type="button" onclick="goToSlide(40);" class="corpus__card" style="background-color:var(--color-n2)">
                <div><img src="stories/greenseas_ch2/img/icon_zoom_n_02.svg"/></div>
                <div class="corpus__cardTitle">Zoom sur Baie de la Forêt</div>
            </a> 
        </div>
    </div>      
</div>

<script>

function toggleLegend(button) {
    // Récupère l'élément de légende qui est dans la même div que le bouton
    const legendBlock = button.closest('.legend__container').querySelector('.legend__block');

    // Ajoute ou retire la classe pour agrandir le bouton
    button.classList.toggle('expand');

    // Affiche ou masque le bloc de légende
    if (legendBlock.style.display === 'block') {
        legendBlock.style.display = 'none';
    } else {
        legendBlock.style.display = 'block';
    }
}

// Timeline param
timelineConfig = {
  startYear: 1920,
  padding: 1,
  currentYear: new Date().getFullYear(),
  get startTimeline() {
    return this.startYear - this.padding;
  },
  get endTimeline() {
    return this.currentYear + this.padding;
  },
  get numberYears() {
    return this.endTimeline - this.startTimeline;
  }
};

function initTimeline() {
  if (document.getElementById("customTimeline")) return;

  const templateEl = document.getElementById("template");
  if (!templateEl) return;

  templateEl.insertAdjacentHTML(
    "afterend",
    `<div class="timeline__block" id="customTimeline" item-type="intro" item-corpus="all"></div>`
  );

  const timelineEl = document.getElementById("customTimeline");

  const parts = [];
  for (
    let year = timelineConfig.startTimeline + 1;
    year < timelineConfig.endTimeline;
    year++
  ) {
    const isDecade = year % 10 === 0;
    parts.push(
      `<div class="timeline__year${isDecade ? " border" : ""}" data-years="${year}">
        <span>${year}</span>
        <div class="timelineItems_list"></div>
      </div>`
    );
  }

  timelineEl.innerHTML = parts.join("");
}

initTimeline();

function initMap() {

  mapStory = ks.mapStorie();

  if (window.wfsLayer) {
    return;
  }

  const wfsUrl =
    "https://geosas.fr/geoserver/wfs?" +
    "service=WFS&version=2.0.0&request=GetFeature" +
    "&typeName=greenseas:enquete_communale_AV_bretagne" +
    "&outputFormat=application/json" +
    "&srsName=EPSG:3857";

  const wfsSource = new ol.source.Vector({
    format: new ol.format.GeoJSON(),
    url: wfsUrl
  });

  const style1982_83 = new ol.style.Style({
    fill: new ol.style.Fill({ color: "rgba(36, 75, 90, 0.8)" }),
    stroke: new ol.style.Stroke({ color: "white", width: 1 })
  });

  const style1984_86 = new ol.style.Style({
    fill: new ol.style.Fill({ color: "rgba(47, 111, 132, 0.8)" }),
    stroke: new ol.style.Stroke({ color: "white", width: 1 })
  });

  const style1987_91 = new ol.style.Style({
    fill: new ol.style.Fill({ color: "rgba(63, 143, 151, 0.8)" }),
    stroke: new ol.style.Stroke({ color: "white", width: 1 })
  });

  const style1992_96 = new ol.style.Style({
    fill: new ol.style.Fill({ color: "rgba(99, 178, 176, 0.8)" }),
    stroke: new ol.style.Stroke({ color: "white", width: 1 })
  });

  const style1997_03 = new ol.style.Style({
    fill: new ol.style.Fill({ color: "rgba(185, 230, 221, 0.8)" }),
    stroke: new ol.style.Stroke({ color: "white", width: 1 })
  });

  const styleDefault = new ol.style.Style({
    fill: new ol.style.Fill({ color: "rgba(200,200,200,0)" }),
    stroke: new ol.style.Stroke({ color: "rgba(200,200,200,0)", width: 0 })
  });


  // Fonction de style
  function styleBySignal(feature) {
    const year = feature.get("signal");

    if (year >= 1982 && year <= 1983) return style1982_83;
    if (year >= 1984 && year <= 1986) return style1984_86;
    if (year >= 1987 && year <= 1991) return style1987_91;
    if (year >= 1992 && year <= 1996) return style1992_96;
    if (year >= 1997 && year <= 2003) return style1997_03;

    return styleDefault;
  }

   window.wfsLayer = new ol.layer.Vector({
    source: wfsSource,
    style: styleBySignal
  });

  mapStory.addLayer( window.wfsLayer);
  window.wfsLayer.setZIndex(1);

  mapStory.getAllLayers().forEach(layer => {
        if (layer.get('name') === 'data_app') {
            layer.setZIndex(2);
        }
  });
}

initMap();

function applyInseeFilter(inseeCodes) {

  if (!window.wfsLayer) {
    console.warn("La couche WFS n'est pas encore chargée.");
    return;
  }
  let codes;

  if (Array.isArray(inseeCodes)) {
    codes = inseeCodes;
  } else {
    codes = inseeCodes
      .toString()
      .split(",")
      .map(code => code.trim())
      .filter(code => code.length > 0);
  }
// Si les codes sont vides ou null, on supprime le CQL_FILTER
  let newUrl = "https://geosas.fr/geoserver/wfs?" +
    "service=WFS&version=2.0.0&request=GetFeature" +
    "&typeName=greenseas:enquete_communale_AV_bretagne" +
    "&outputFormat=application/json" +
    "&srsName=EPSG:3857";

  if (codes && codes.length > 0) {
    const cql = `INSEE IN ('${codes.join("','")}')`; 
    newUrl += "&CQL_FILTER=" + encodeURIComponent(cql);
  }

  // Mise à jour de l'URL de la source WFS
  const source = window.wfsLayer.getSource();
  source.setUrl(newUrl);
  source.refresh();
}

// Update daza-actual-slide attribute to btn caroussel
function slideTo(id) {
    const btnCaroussel = document.querySelectorAll(".carButton a"); 
    btnCaroussel.forEach(element => {
        element.setAttribute("data-actual-slide", id);
        
    });
}

// Function change slide 
function goToSlide(id){
    const featureId = document.querySelector(`#myCarousel .carousel-indicators button[data-featureid="${id}"]`);
    if (!featureId) {
        console.error('Le bouton correspondant à cet ID n\'a pas été trouvé.');
        return;
    }

    const slideId = parseInt(featureId.getAttribute("data-bs-slide-to"), 10);
    
    if (isNaN(slideId)) {
        console.error('L\'ID du slide n\'est pas valide.');
        return;
    }
    $('.carousel').carousel(slideId);
    slideTo(slideId);
}

// Create point for data
function addDate(date,id) {
    let idItem = document.querySelector(".carousel-indicators button[data-featureid='"+ id +"']");
    let slideItem = idItem.getAttribute("data-bs-slide-to");
    div = document.querySelector("#customTimeline .timeline__year[data-years='" + date + "'] .timelineItems_list");
    div.innerHTML += `<div class='timeline__item time__{{zoom_code}}' id='timelineItem__{{id}}'><a type='button' onclick="$('.carousel').carousel(${slideItem});slideTo(${slideItem});"><div class='timeline__itemPoint' ><div class='timeline__itemHover'>{{name}}</div></div></a></div>`;
};  

// Create bar for corpus
function addPeriode(start,end,id) {
    const timelineWidth = document.querySelector("#customTimeline").offsetWidth;
    let yearsPeriode = end - start +1;
    let sizeBar= (timelineWidth/timelineConfig.numberYears) * yearsPeriode;
    let sizeBarPerc = sizeBar*100/timelineWidth;
    let idItem = document.querySelector(".carousel-indicators button[data-featureid='"+ id +"']");
    let slideItem = idItem.getAttribute("data-bs-slide-to");
    div = document.querySelector("#customTimeline .timeline__year[data-years='" + start + "'] .timelineItems_list");
    div.innerHTML += `<div class='timeline__item time__{{zoom_code}}' id='timelineItem__{{id}}'><a type='button' onclick="$('.carousel').carousel(${slideItem});slideTo(${slideItem});"><div class='timeline__itemPeriode' style='width:${sizeBarPerc}%!important'><div class='timeline__itemHover'>{{name}}</div></div></a></div>`;        
};

{{#date_end}}
    addPeriode({{date_start}},{{date_end}},{{id}});
{{/date_end}}
{{^date_end}}
    {{#date_start}}
        addDate({{date_start}},{{id}});
    {{/date_start}}
{{/date_end}}

// Event change item 
$('.carousel').on('slide.bs.carousel', function (e) {
    // Type of item
    let currentItemType = e.relatedTarget.firstChild.nextSibling.getAttribute("item-type");
    let currentItemCorpus = e.relatedTarget.firstChild.nextSibling.getAttribute("item-corpus");
    let currentItemInsee = e.relatedTarget.firstChild.nextSibling.getAttribute("item-insee");
    let timeline = document.querySelector("#customTimeline");
    timeline.setAttribute("item-type", currentItemType);
    timeline.setAttribute("item-corpus", currentItemCorpus);
    applyInseeFilter(currentItemInsee);
    // Add active class to item timeline
    let timelineActiv = document.querySelector(".timeline__active");
    if(timelineActiv){
        timelineActiv.classList.remove("timeline__active");
    }    
    if(currentItemType != "intro"){
        let currentItemId = e.relatedTarget.attributes["data-featureid"].value;
        let currentItemDate = document.querySelector("#timelineItem__"+ currentItemId +"")
        currentItemDate.classList.add("timeline__active");
    }    
});

// Get data for each corpus 
if("{{type}}" === "zoom"){
  var urlCsvData = "stories/greenseas_ch2/greenseas_info_ch2.csv";
  Papa.parse(urlCsvData, {
    header: true,
    download: true,
    complete: function(results) {       
      const corpus_id = "{{zoom_code}}"
      const filteredData = results.data.filter(item => item.id_zoom === corpus_id && item.niveau === "3");
      const fdiv = document.getElementById('corpusDataList_{{zoom_code}}');
      filteredData.forEach(item => {  // Ajouter le titre à la div
        let cardFeature = `
        <a type="button" onclick="goToSlide(${item.id_story});" class="corpus__card">
                <div class="corpus__cardTitle">${item.titre}</div>
            </a>
        `;
        fdiv.insertAdjacentHTML( 'beforeend', cardFeature );  // Ajouter la div au conteneur parent
      });
    },
  });      
}
</script>
{{/id}}